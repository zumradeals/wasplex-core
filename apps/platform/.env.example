APP_NAME=Wasplex
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
APP_TIMEZONE=UTC
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://localhost:5173

LOG_CHANNEL=stderr
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=wasplex
DB_USERNAME=wasplex
DB_PASSWORD=wasplex_local_only
DB_SSLMODE=prefer

CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_CONNECTION=default
QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MAIL_MAILER=log

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=af-south-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true

# Médias du Studio Annonceur. Utiliser s3 sur les environnements partagés/production.
ADVERTISER_ASSET_DISK=public
ADVERTISER_IMAGE_MAX_KB=10240
ADVERTISER_VIDEO_MAX_KB=51200

# GeniusPay reste obligatoirement en sandbox jusqu'au chantier P021.
GENIUSPAY_MODE=sandbox
GENIUSPAY_BASE_URL=https://pay.genius.ci/api/v1/merchant
GENIUSPAY_API_KEY=
GENIUSPAY_API_SECRET=
GENIUSPAY_WEBHOOK_SECRET=
GENIUSPAY_WEBHOOK_TOLERANCE_SECONDS=300
GENIUSPAY_MINIMUM_DEPOSIT_MINOR=200
GENIUSPAY_MAXIMUM_DEPOSIT_MINOR=5000000

VITE_APP_NAME="${APP_NAME}"

APP_NAME=Wasplex
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
APP_TIMEZONE=UTC
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://localhost:5173

LOG_CHANNEL=stderr
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=wasplex
DB_USERNAME=wasplex
DB_PASSWORD=wasplex_local_only
DB_SSLMODE=prefer

CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_CONNECTION=default
QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MAIL_MAILER=log

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=af-south-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true

# Médias du Studio Annonceur. Utiliser s3 sur les environnements partagés/production.
ADVERTISER_ASSET_DISK=public
ADVERTISER_IMAGE_MAX_KB=10240
ADVERTISER_VIDEO_MAX_KB=51200

# P006 reste un catalogue et une estimation sandbox jusqu'à validation commerciale.
CAMPAIGN_SANDBOX_CPM_MINOR=1000
CAMPAIGN_MINIMUM_BUDGET_MINOR=5000
CAMPAIGN_QUOTE_VALIDITY_HOURS=48
CAMPAIGN_RESERVATION_VALIDITY_DAYS=30
CAMPAIGN_PLANNING_REACH_PER_RADIUS_KM=4000

# P007 : politique de revue administrative.
CAMPAIGN_REVIEW_REQUIRE_DISTINCT_DECIDER=false
CAMPAIGN_REVIEW_DEFAULT_DUE_HOURS=24

# P008 : confidentialité des segments, fréquence et fatigue préparatoires au Feed.
ADVERTISING_MINIMUM_SEGMENT_SIZE=25
ADVERTISING_ESTIMATE_ROUNDING_STEP=10
ADVERTISING_FREQUENCY_WINDOW_HOURS=24
ADVERTISING_FREQUENCY_LIMIT=3
ADVERTISING_FATIGUE_LIMIT=100
ADVERTISING_SUBJECT_HASH_KEY=

# P008-R : Profil intelligent international. Le Mali est le marché initial,
# sans limiter l'architecture à un seul pays. L'IA reste désactivée tant que
# son fournisseur, son audit et ses règles de gouvernance ne sont pas validés.
PROFILE_INTELLIGENCE_DEFAULT_MARKET=ML
PROFILE_INTELLIGENCE_DEFAULT_LOCALE=fr
PROFILE_INTELLIGENCE_AI_ENABLED=false
PROFILE_INTELLIGENCE_AI_MINIMUM_CONFIDENCE=0.75

# P009-A : Super Moteur publicitaire. Le client ne crée jamais de WP :
# seule une preuve d'attention validée côté serveur peut déclencher le règlement.
VALUE_ENGINE_ADVERTISING_EVENT_CODE=AD_QUALIFIED_ATTENTION
VALUE_ENGINE_ADVERTISING_RULE_CODE=advertising.qualified-attention
VALUE_ENGINE_USER_SHARE_BPS=5000
VALUE_ENGINE_WASPLEX_SHARE_BPS=5000
VALUE_ENGINE_MINIMUM_EVENT_AMOUNT_MINOR=2
VALUE_ENGINE_REQUIRED_ATTENTION_MS=10000
VALUE_ENGINE_HEARTBEAT_INTERVAL_MS=5000
VALUE_ENGINE_ATTEMPT_TTL_SECONDS=300
VALUE_ENGINE_HEARTBEAT_CLOCK_SKEW_SECONDS=30

# P009-B/P009-C : livraison, quota et lecteur du Feed utilisateur.
DISTRIBUTION_FEED_SESSION_TTL_SECONDS=900
DISTRIBUTION_DELIVERY_LEASE_TTL_SECONDS=30
DISTRIBUTION_MATCH_TTL_MINUTES=60
DISTRIBUTION_CANDIDATE_LIMIT=50
DISTRIBUTION_MEDIA_LOAD_TIMEOUT_MS=15000
DISTRIBUTION_DEFAULT_MARKET=CI
DISTRIBUTION_DEFAULT_CURRENCY=XOF

# Valeurs de secours initiales. L’écran Administration > Paiements peut ensuite
# stocker les identifiants GeniusPay chiffrés en base sans les réafficher.
GENIUSPAY_MODE=sandbox
GENIUSPAY_BASE_URL=https://geniuspay.ci/api/v1/merchant
GENIUSPAY_CHECKOUT_HOSTS=geniuspay.ci,pay.genius.ci
GENIUSPAY_API_KEY=
GENIUSPAY_API_SECRET=
GENIUSPAY_WEBHOOK_SECRET=
GENIUSPAY_WEBHOOK_TOLERANCE_SECONDS=300
GENIUSPAY_MINIMUM_DEPOSIT_MINOR=200
GENIUSPAY_MAXIMUM_DEPOSIT_MINOR=5000000

# Les clés Production peuvent être enregistrées et testées dans l’administration,
# mais leur activation reste interdite jusqu’à une décision explicite de gouvernance.
GENIUSPAY_ALLOW_PRODUCTION_ACTIVATION=false

VITE_APP_NAME="${APP_NAME}"

APP_NAME=Wasplex
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=structured
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=wasplex
DB_USERNAME=wasplex
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=wasplex_cache

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@wasplex.local"
MAIL_FROM_NAME="${APP_NAME}"

# Stockage S3 compatible (MinIO en local, voir infra/compose.yaml).
# Passer FILESYSTEM_DISK=s3 après installation de league/flysystem-aws-s3-v3.
AWS_ACCESS_KEY_ID=wasplex_local
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=wasplex-local
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_ENDPOINT=http://127.0.0.1:9000
AWS_URL=http://127.0.0.1:9000/wasplex-local

# Wallet annonceur — GeniusPay sandbox uniquement (docs/chantiers/
# HOTFIX-P003-GENIUSPAY-SANDBOX.md). Ne jamais renseigner de clé "live" ici.
GENIUSPAY_ENVIRONMENT=sandbox
GENIUSPAY_BASE_URL=https://pay.genius.ci/api/v1/merchant
GENIUSPAY_API_KEY=pk_sandbox_xxxxxxxx
GENIUSPAY_API_SECRET=sk_sandbox_xxxxxxxx
GENIUSPAY_WEBHOOK_SECRET=
GENIUSPAY_CHECKOUT_HOSTS=geniuspay.ci,pay.genius.ci

VITE_APP_NAME="${APP_NAME}"

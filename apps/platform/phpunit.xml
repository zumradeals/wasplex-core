<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="5432"/>
        <env name="DB_DATABASE" value="wasplex_test"/>
        <env name="DB_USERNAME" value="wasplex"/>
        <env name="DB_PASSWORD" value="wasplex_local_only"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <!--
            The "array" session driver (Laravel's stock testing default)
            never survives across separate simulated HTTP calls within a
            test, which makes it unusable for asserting on account_sessions
            revocation (docs/chantiers/P001-CHANTIER.md invariant). Redis
            matches the real runtime target and is provisioned in CI.
        -->
        <env name="SESSION_DRIVER" value="redis"/>
        <env name="REDIS_HOST" value="127.0.0.1"/>
        <env name="REDIS_PORT" value="6379"/>
        <env name="FILESYSTEM_DISK" value="local"/>
        <!--
            GeniusPay is always mocked via Http::fake() in tests
            (docs/chantiers/P003-CHANTIER.md) — these values only need to
            satisfy GeniusPayAdapter's own boot-time safety checks (HTTPS
            base URL, sandbox environment, no "live" in the key).
        -->
        <env name="GENIUSPAY_ENVIRONMENT" value="sandbox"/>
        <env name="GENIUSPAY_BASE_URL" value="https://geniuspay.ci/api/v1/merchant"/>
        <env name="GENIUSPAY_MERCHANT_KEY" value="sandbox_test_key"/>
        <env name="GENIUSPAY_WEBHOOK_SECRET" value="sandbox_test_secret"/>
        <env name="GENIUSPAY_CHECKOUT_HOSTS" value="geniuspay.ci,pay.genius.ci"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
